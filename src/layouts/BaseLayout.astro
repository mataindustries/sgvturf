---
import '../styles/tokens.css';
import '../styles/global.css';
import {
  defaultDescription,
  defaultOgDescription,
  defaultOgTitle,
  defaultSocialImage,
  defaultTitle,
  siteName,
} from '../data/site';
import { toAbsoluteUrl, toCanonicalUrl, toJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  socialImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const gaMeasurementId = 'G-20YE3554RG';

const {
  title = defaultTitle,
  description = defaultDescription,
  canonicalUrl = Astro.url.pathname,
  ogTitle = defaultOgTitle,
  ogDescription = defaultOgDescription,
  socialImage = defaultSocialImage,
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const canonicalHref = toCanonicalUrl(canonicalUrl, Astro.site);
const socialImageUrl = toAbsoluteUrl(socialImage, Astro.site);
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const jsonLdEntries = toJsonLd(structuredData);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f0e4" />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="800x800" href="/sgvturf-ad-logo.png" />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={socialImageUrl} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Mono:wght@400;500&family=Libre+Baskerville:ital@0;1&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      window.gtag('js', new Date());
      window.gtag('config', gaMeasurementId);
      const attributionMap = {
        source: 'utm_source',
        medium: 'utm_medium',
        campaign: 'utm_campaign',
        content: 'utm_content',
        term: 'utm_term',
        gclid: 'gclid',
        gbraid: 'gbraid',
        wbraid: 'wbraid',
        msclkid: 'msclkid',
      };
      const captureAttribution = () => {
        let stored = {};
        try { stored = JSON.parse(sessionStorage.getItem('sgvturf_attribution') || '{}'); } catch { stored = {}; }
        const query = new URLSearchParams(window.location.search);
        Object.entries(attributionMap).forEach(([field, queryName]) => {
          const value = query.get(queryName);
          if (value) stored[field] = value.slice(0, 300);
        });
        sessionStorage.setItem('sgvturf_attribution', JSON.stringify(stored));
        return stored;
      };
      window.SGVTurfAnalytics = window.SGVTurfAnalytics || {
        track(eventName, params) {
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, params || {});
          }
        },
        attribution(params) {
          return { ...captureAttribution(), ...(params || {}) };
        },
        captureAttribution,
      };
      window.SGVTurfAnalytics.captureAttribution();
    </script>
    <title>{title}</title>
    {jsonLdEntries.map((entry) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(entry).replace(/</g, '\\u003c')}
      />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script is:inline>
      if (!window.__sgvTurfClickTrackingBound) {
        window.__sgvTurfClickTrackingBound = true;
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('[data-analytics-event]') : null;
          const eventName = link?.getAttribute('data-analytics-event');
          if (!eventName) return;
          window.SGVTurfAnalytics?.track(
            eventName,
            window.SGVTurfAnalytics.attribution({ page_path: window.location.pathname }),
          );
        });
      }
    </script>
  </body>
</html>
