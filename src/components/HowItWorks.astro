---
const steps = [
  {
    number: '01',
    title: 'Choose a direction',
    description: 'Compare lower-water planting, mixed-use layouts, and low-maintenance surfaces against how you actually use the yard.',
  },
  {
    number: '02',
    title: 'Build your free brief',
    description: 'Organize your city, yard size, priorities, timing, and style into one clear contractor-ready project summary.',
  },
  {
    number: '03',
    title: 'Compare with confidence',
    description: 'Use the brief to ask better questions, check current rebate requirements, and compare proposals on the same scope.',
  },
];
---

<section class="surface-section surface-section--cream">
  <div class="section-shell">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Three simple steps</p>
        <h2 class="section-title">
          A clearer plan before<br />
          <em>the first estimate.</em>
        </h2>
      </div>
    </div>

    <div class="steps-grid">
      {steps.map((step) => (
        <article class="step-card">
          <div class="step-card__number">{step.number}</div>
          <h3 class="step-card__title">{step.title}</h3>
          <p class="step-card__description">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
