---
import ProjectBriefForm from './ProjectBriefForm.astro';

const benefits = [
  'Tell SGVTurf about the yard, city, goals, size, timing, and desired work',
  'SGVTurf organizes the essentials into a contractor-ready starting scope',
  'Use the brief to compare options, rebate questions, and proposals consistently',
];
---

<section class="lead-section" id="quote">
  <div class="section-shell lead-section__inner">
    <div class="lead-section__copy">
      <p class="section-eyebrow section-eyebrow--soft">Free Project Brief</p>
      <h2 class="lead-section__title">Organize the yard project.<br /><em>Make the next call clearer.</em></h2>
      <p class="lead-section__description">SGVTurf is a regional planning and referral resource. It does not perform landscape installation, and contractor availability is not guaranteed.</p>
      <ul class="benefit-list">{benefits.map((benefit) => <li>{benefit}</li>)}</ul>
    </div>
    <ProjectBriefForm />
  </div>
</section>
