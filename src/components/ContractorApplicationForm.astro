---
import FormHandler from './FormHandler.astro';
const attributionFields = ['source', 'medium', 'campaign', 'content', 'term', 'gclid', 'gbraid', 'wbraid', 'msclkid'];
---

<form id="contractor-application" class="lead-form" action="/api/lead" method="post" data-submission-form data-start-event="contractor_form_start" data-success-event="contractor_form_success" data-error-event="form_delivery_error">
  <h2 class="lead-form__title">Founding Partner Intake</h2>
  <p class="lead-form__subtitle">Short real-business application · required fields marked</p>
  <input type="hidden" name="submissionType" value="contractor" />
  <input type="hidden" name="landingPage" value={Astro.url.pathname} />
  <input type="hidden" name="referrer" value="" />
  {attributionFields.map((name) => <input type="hidden" name={name} value="" />)}
  <div class="form-row">
    <label class="field"><span class="field__label">Legal business name — required</span><input class="field__control" name="businessName" autocomplete="organization" maxlength="180" required /><span class="field__error" data-field-error="businessName"></span></label>
    <label class="field"><span class="field__label">Contact name — required</span><input class="field__control" name="contactName" autocomplete="name" maxlength="120" required /><span class="field__error" data-field-error="contactName"></span></label>
  </div>
  <div class="form-row">
    <label class="field"><span class="field__label">Public email — required</span><input class="field__control" type="email" name="email" autocomplete="email" maxlength="200" required /><span class="field__error" data-field-error="email"></span></label>
    <label class="field"><span class="field__label">Public phone — required</span><input class="field__control" type="tel" name="phone" autocomplete="tel" maxlength="40" required /><span class="field__error" data-field-error="phone"></span></label>
  </div>
  <label class="field"><span class="field__label">Website — optional</span><input class="field__control" type="url" name="website" autocomplete="url" placeholder="https://" maxlength="300" /><span class="field__error" data-field-error="website"></span></label>
  <div class="form-row">
    <label class="field"><span class="field__label">Service areas — required</span><textarea class="field__control field__control--textarea" name="serviceAreas" maxlength="1200" required></textarea><span class="field__error" data-field-error="serviceAreas"></span></label>
    <label class="field"><span class="field__label">Specialties — required</span><textarea class="field__control field__control--textarea" name="specialties" maxlength="1200" required></textarea><span class="field__error" data-field-error="specialties"></span></label>
  </div>
  <label class="field"><span class="field__label">License number/status when applicable — required</span><input class="field__control" name="licenseNumber" maxlength="240" placeholder="Number and status, or explain why not applicable" required /><span class="field__error" data-field-error="licenseNumber"></span></label>
  <label class="field"><span class="field__label">Shareable project photo links — optional</span><textarea class="field__control field__control--textarea" name="photoLinks" maxlength="2000" placeholder="One link per line. Photo collection can follow acceptance if links are not ready."></textarea></label>
  <label class="field"><span class="field__label">Anything else SGVTurf should know? — optional</span><textarea class="field__control field__control--textarea" name="message" maxlength="3000"></textarea></label>
  <label class="checkbox-field"><input type="checkbox" name="materialsPermission" value="yes" required /><span>I confirm SGVTurf may display the submitted logo, project photos, and business information if accepted — required.</span></label><span class="field__error" data-field-error="materialsPermission"></span>
  <label class="checkbox-field"><input type="checkbox" name="responseCommitment" value="yes" required /><span>I agree to keep business information accurate and respond promptly to relevant forwarded inquiries — required.</span></label><span class="field__error" data-field-error="responseCommitment"></span>
  <label class="checkbox-field"><input type="checkbox" name="caseStudyPermission" value="yes" required /><span>I agree that anonymized campaign outcomes may be used in a case study — required.</span></label><span class="field__error" data-field-error="caseStudyPermission"></span>
  <div class="field field--hidden" aria-hidden="true"><label>Leave this field blank<input type="text" name="faxNumber" tabindex="-1" autocomplete="off" /></label></div>
  <button class="button button--primary button--submit" type="submit" data-submit-button>Apply for the Free Test</button>
  <p class="lead-form__status" data-form-status aria-live="polite" hidden></p>
  <p class="lead-form__note">SGVTurf uses this information to review and respond to the application. No placement, traffic, lead volume, revenue, or campaign approval is guaranteed. See the <a class="text-link" href="/privacy/">Privacy Policy</a>.</p>
</form>
<FormHandler />
