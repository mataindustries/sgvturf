---
import type { RebateEntry } from '../data/rebates';
const { entry } = Astro.props as { entry: RebateEntry };
---
<article class="rebate-card">
  <div class="rebate-card__header"><p class="rebate-card__eyebrow">{entry.districtName}</p><h3 class="rebate-card__title">{entry.rebateType}</h3></div>
  <div class="rebate-card__meta"><div><p class="rebate-card__label">Coverage</p><p class="rebate-card__value">{entry.coverageArea}</p></div><div><p class="rebate-card__label">Current Published Incentive</p><p class="rebate-card__value rebate-card__value--emphasis">{entry.publishedIncentive}</p></div><div><p class="rebate-card__label">Last verified</p><p class="rebate-card__value">{entry.lastVerified}</p></div></div>
  <p class="rebate-card__notes">{entry.notes}</p>
  <a class="button button--ghost rebate-card__action" href={entry.officialUrl} target="_blank" rel="noopener noreferrer">Open Official Program</a>
</article>
