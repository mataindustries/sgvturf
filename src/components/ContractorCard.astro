---
import type { ProjectStyleGuide } from '../data/contractors';

interface Props {
  guide: ProjectStyleGuide;
}

const { guide } = Astro.props;
---

<article class:list={['contractor-card', guide.featured && 'contractor-card--featured']}>
  <div class="contractor-card__badge">Planning Archetype</div>

  <div class:list={['contractor-card__logo', `contractor-card__logo--${guide.tone}`]} aria-hidden="true">
    {guide.initials}
  </div>

  <h3 class="contractor-card__name">{guide.name}</h3>
  <p class="archetype-disclosure">Illustrative planning archetype — not a contractor or business.</p>
  <p class="contractor-card__city">Relevant SGV settings: {guide.serviceAreas.join(' · ')}</p>
  <p class="contractor-card__summary">{guide.tagline}</p>

  <div class="tag-list">
    {guide.specialties.map((specialty) => (
      <span class="tag">{specialty}</span>
    ))}
  </div>

  <p class="contractor-card__blurb">{guide.trustBlurb}</p>
  <a class="inline-link" href={`/project-style-guides/${guide.slug}/`} aria-label={`View the ${guide.name} illustrative planning archetype`}>View Style Guide</a>
</article>
