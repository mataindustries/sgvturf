---
import { resources } from '../data/resources';
import ResourceCard from './ResourceCard.astro';

const selectedResources = resources.slice(0, 3);
---

<section class="surface-section surface-section--cream" id="resources">
  <div class="section-shell">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">Selected planning resources</p>
        <h2 class="section-title">
          Practical guidance for<br />
          <em>a clearer yard plan.</em>
        </h2>
      </div>

      <a class="button button--ghost section-header__action" href="/resources/">All Resources</a>
    </div>

    <div class="editorial-grid">
      {selectedResources.map((article) => (
        <ResourceCard article={article} />
      ))}
    </div>
  </div>
</section>
