---
import { cities } from '../data/cities';
import { rebateEntries } from '../data/rebates';
import { resources } from '../data/resources';

const stats = [
  { value: 'Opening', label: 'Verified Roster' },
  { value: `${cities.length}`, label: 'City Guides' },
  { value: `${rebateEntries.length}`, label: 'Official Rebate Sources' },
  { value: `${resources.length}`, label: 'Editorial Reads' },
];
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__image"
      src="/img/sgv-turf-yard-before.webp"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__after-reveal">
      <img
        class="hero__image"
        src="/img/sgv-turf-yard-after.webp"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="hero__reveal-line"></div>
    <div class="hero__wash"></div>
  </div>

  <div class="section-shell hero__grid">
    <div class="hero__copy">
      <div class="hero__eyebrow">San Gabriel Valley front-yard planning</div>
      <h1 class="hero__title">Ditch the lawn. Build a better SGV yard.</h1>
      <p class="hero__lede">
        Find drought-smart landscape ideas, honest referral guidance, and official-source rebate planning for
        front-yard projects across the San Gabriel Valley.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="/sgv-yard-project/">Start Your Free Project Brief</a>
      </div>

      <div class="hero__stats" aria-label="SGV Turf highlights">
        {stats.map((stat) => (
          <div class="hero-stat">
            <div class="hero-stat__value">{stat.value}</div>
            <div class="hero-stat__label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
