---
import { cities } from '../data/cities';
import { contractors } from '../data/contractors';
import { rebateEntries } from '../data/rebates';
import { resources } from '../data/resources';

const stats = [
  { value: `${contractors.length}`, label: 'Contractor Profiles' },
  { value: `${cities.length}`, label: 'City Guides' },
  { value: `${rebateEntries.length}`, label: 'Rebate Lanes' },
  { value: `${resources.length}`, label: 'Editorial Reads' },
];
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <img
      class="hero__image"
      src="/img/sgv-turf-drought-tolerant-front-yard-san-gabriel-valley.jpg"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__wash"></div>
  </div>

  <div class="hero-right hero__yard-stage" aria-hidden="true">
    <div class="hero-illustration"></div>
    <canvas class="yard-scan-canvas" aria-hidden="true"></canvas>
    <div class="plant-shapes">
      <svg viewBox="0 0 600 520" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax meet">
        <ellipse cx="120" cy="480" rx="90" ry="20" fill="rgba(44,56,32,0.38)" />
        <path d="M120 460 Q82 382 42 340 Q64 360 100 390 Q92 330 120 280 Q132 342 120 390 Q150 360 186 340 Q160 382 120 460Z" fill="#3d5230" opacity="0.82" />
        <path d="M120 460 Q120 382 120 282" stroke="#2c3820" stroke-width="2" opacity="0.34" />
        <ellipse cx="60" cy="490" rx="50" ry="14" fill="rgba(44,56,32,0.28)" />
        <circle cx="60" cy="476" r="22" fill="#506840" opacity="0.84" />
        <circle cx="60" cy="476" r="14" fill="#5c7848" opacity="0.9" />
        <circle cx="60" cy="476" r="8" fill="#6b8858" />
        <path d="M300 520 Q285 420 270 340" stroke="#7a9060" stroke-width="3" fill="none" opacity="0.62" />
        <path d="M300 520 Q310 430 330 350" stroke="#7a9060" stroke-width="3" fill="none" opacity="0.62" />
        <path d="M300 520 Q290 440 280 360 Q275 340 265 320" stroke="#8fa870" stroke-width="2" fill="none" opacity="0.46" />
        <path d="M300 520 Q315 440 335 360 Q340 340 350 318" stroke="#8fa870" stroke-width="2" fill="none" opacity="0.46" />
        <rect x="0" y="490" width="600" height="30" fill="#4a3828" opacity="0.36" />
        <rect x="460" y="360" width="28" height="140" rx="14" fill="#4a6038" opacity="0.76" />
        <rect x="488" y="400" width="20" height="60" rx="10" fill="#4a6038" opacity="0.72" />
        <rect x="440" y="420" width="20" height="50" rx="10" fill="#4a6038" opacity="0.72" />
        <ellipse cx="474" cy="358" rx="16" ry="8" fill="#5a7048" opacity="0.82" />
        <ellipse cx="200" cy="504" rx="18" ry="6" fill="#6b5840" opacity="0.28" />
        <ellipse cx="380" cy="508" rx="14" ry="5" fill="#6b5840" opacity="0.24" />
        <ellipse cx="500" cy="502" rx="20" ry="6" fill="#6b5840" opacity="0.28" />
        <circle cx="220" cy="490" r="16" fill="#608050" opacity="0.78" />
        <circle cx="220" cy="490" r="9" fill="#7a9868" opacity="0.84" />
        <circle cx="400" cy="488" r="12" fill="#506840" opacity="0.78" />
        <circle cx="400" cy="488" r="7" fill="#688a58" opacity="0.84" />
      </svg>
    </div>
    <div class="hero-badge">
      <div class="hero-badge-text">SGV TURF<br />AUTHORITY<br />EST. 2024</div>
    </div>
  </div>

  <div class="section-shell hero__grid">
    <div class="hero__copy">
      <div class="hero__eyebrow">San Gabriel Valley front-yard planning</div>
      <h1 class="hero__title">Ditch the lawn. Build a better SGV yard.</h1>
      <p class="hero__lede">
        Find drought-smart landscape ideas, local contractor placement, and rebate guidance for
        front-yard projects across the San Gabriel Valley.
      </p>

      <div class="hero__actions">
        <a class="button button--primary" href="/#quote">Start Your Project Brief</a>
      </div>

      <div class="hero__stats" aria-label="SGV Turf highlights">
        {stats.map((stat) => (
          <div class="hero-stat">
            <div class="hero-stat__value">{stat.value}</div>
            <div class="hero-stat__label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const initYardScan = () => {
    const stage = document.querySelector('.hero__yard-stage');
    const canvas = stage?.querySelector('.yard-scan-canvas');

    if (!(stage instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) {
      return;
    }

    const ctx = canvas.getContext('2d', { alpha: true });

    if (!ctx) {
      return;
    }

    const palette = {
      sage: '#7a8c6e',
      sageLight: '#b5c4a8',
      sageDark: '#4a5c40',
      terracotta: '#c8603a',
      terracottaLight: '#e8927a',
      sand: '#e8dfc8',
      sandDark: '#d4c8a8',
      soil: '#2c1f14',
      cream: '#f5efe0',
      olive: '#6b7340',
      stone: '#8c8070',
      white: '#fdfaf4',
    };

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let dpr = 1;
    let scene = null;
    let pointerShift = { x: 0, y: 0 };
    let frameId = 0;
    let hidden = document.hidden;
    let reducedMotion = motionQuery.matches;
    let start = performance.now();

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const easeInOut = (value) =>
      value < 0.5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;
    const easeOut = (value) => 1 - Math.pow(1 - value, 3);

    const seededRandom = (seed) => {
      let value = seed;

      return () => {
        value = (value * 1664525 + 1013904223) % 4294967296;
        return value / 4294967296;
      };
    };

    const createScene = () => {
      const mobile = width < 760;
      const random = seededRandom(mobile ? 714 : 1427);
      const gravelCount = mobile ? 82 : 176;
      const lawnSpecks = mobile ? 34 : 70;
      const gravel = [];
      const specks = [];

      for (let index = 0; index < gravelCount; index += 1) {
        gravel.push({
          x: 0.05 + random() * 0.9,
          y: 0.08 + random() * 0.84,
          r: 0.0018 + random() * 0.0036,
          tone: random(),
        });
      }

      for (let index = 0; index < lawnSpecks; index += 1) {
        specks.push({
          x: 0.04 + random() * 0.92,
          y: 0.06 + random() * 0.88,
          len: 0.016 + random() * 0.03,
          angle: -0.6 + random() * 1.2,
          alpha: 0.07 + random() * 0.11,
        });
      }

      return {
        mobile,
        gravel,
        specks,
        plants: mobile
          ? [
              { x: 0.2, y: 0.68, size: 0.105, type: 'agave' },
              { x: 0.46, y: 0.31, size: 0.07, type: 'shrub' },
              { x: 0.7, y: 0.38, size: 0.083, type: 'succulent' },
              { x: 0.77, y: 0.72, size: 0.07, type: 'grass' },
            ]
          : [
              { x: 0.16, y: 0.67, size: 0.104, type: 'agave' },
              { x: 0.29, y: 0.34, size: 0.06, type: 'shrub' },
              { x: 0.39, y: 0.24, size: 0.06, type: 'succulent' },
              { x: 0.53, y: 0.62, size: 0.086, type: 'grass' },
              { x: 0.66, y: 0.31, size: 0.072, type: 'shrub' },
              { x: 0.74, y: 0.39, size: 0.086, type: 'agave' },
              { x: 0.83, y: 0.74, size: 0.066, type: 'succulent' },
            ],
        labels: mobile
          ? [
              { text: 'WATER-WISE PLAN', x: 0.12, y: 0.16, delay: 0 },
              { text: 'REBATE CHECK', x: 0.54, y: 0.74, delay: 0.1 },
              { text: 'SGV MATCH READY', x: 0.3, y: 0.5, delay: 0.2 },
            ]
          : [
              { text: 'WATER-WISE PLAN', x: 0.1, y: 0.15, delay: 0 },
              { text: 'REBATE CHECK', x: 0.58, y: 0.2, delay: 0.08 },
              { text: 'SGV MATCH READY', x: 0.4, y: 0.58, delay: 0.18 },
            ],
      };
    };

    const resizeYardCanvas = () => {
      const rect = stage.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width * dpr));
      height = Math.max(1, Math.round(rect.height * dpr));
      canvas.width = width;
      canvas.height = height;
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      scene = createScene();
      drawFrame(reducedMotion ? 1 : 0, reducedMotion);
    };

    const getPlan = () => {
      const planWidth = Math.min(width * (scene.mobile ? 0.9 : 0.88), height * 1.28);
      const planHeight = Math.min(height * (scene.mobile ? 0.76 : 0.78), planWidth * 0.72);

      return {
        x: width * 0.5 - planWidth * 0.5,
        y: height * (scene.mobile ? 0.53 : 0.52) - planHeight * 0.5,
        width: planWidth,
        height: planHeight,
        radius: Math.max(12 * dpr, planWidth * 0.028),
        rotation: scene.mobile ? -0.045 : -0.075,
      };
    };

    const withPlanTransform = (plan, draw) => {
      ctx.save();
      ctx.translate(plan.x + plan.width * 0.5, plan.y + plan.height * 0.5);
      ctx.rotate(plan.rotation);
      ctx.translate(-plan.width * 0.5, -plan.height * 0.5);
      draw();
      ctx.restore();
    };

    const clipPlan = (plan) => {
      ctx.beginPath();
      ctx.roundRect(0, 0, plan.width, plan.height, plan.radius);
      ctx.clip();
    };

    const drawBackground = () => {
      ctx.clearRect(0, 0, width, height);

      const gradient = ctx.createLinearGradient(0, 0, width, height);
      gradient.addColorStop(0, '#879a78');
      gradient.addColorStop(0.36, '#4a5c40');
      gradient.addColorStop(1, '#202a19');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);

      const tableGlow = ctx.createRadialGradient(width * 0.58, height * 0.38, 0, width * 0.58, height * 0.38, Math.max(width, height) * 0.72);
      tableGlow.addColorStop(0, 'rgba(245, 239, 224, 0.17)');
      tableGlow.addColorStop(0.48, 'rgba(181, 196, 168, 0.07)');
      tableGlow.addColorStop(1, 'rgba(20, 28, 17, 0)');
      ctx.fillStyle = tableGlow;
      ctx.fillRect(0, 0, width, height);

      ctx.save();
      ctx.strokeStyle = 'rgba(245, 239, 224, 0.075)';
      ctx.lineWidth = 1 * dpr;

      for (let index = 0; index < 8; index += 1) {
        const y = height * (0.14 + index * 0.12);
        ctx.beginPath();
        ctx.moveTo(width * -0.08, y);

        for (let x = -width * 0.08; x <= width * 1.08; x += width / 7) {
          ctx.quadraticCurveTo(
            x + width * 0.06,
            y + Math.sin(index + x * 0.004) * height * 0.035,
            x + width * 0.14,
            y + Math.cos(index + x * 0.003) * height * 0.025,
          );
        }

        ctx.stroke();
      }

      ctx.restore();
    };

    const drawYardPlan = (plan) => {
      ctx.save();
      ctx.shadowColor = 'rgba(21, 16, 11, 0.24)';
      ctx.shadowBlur = 18 * dpr;
      ctx.shadowOffsetY = 10 * dpr;
      ctx.fillStyle = 'rgba(253, 250, 244, 0.22)';
      ctx.beginPath();
      ctx.roundRect(-plan.width * 0.018, -plan.height * 0.024, plan.width * 1.036, plan.height * 1.048, plan.radius * 1.18);
      ctx.fill();
      ctx.restore();

      ctx.save();
      ctx.shadowColor = 'rgba(21, 16, 11, 0.34)';
      ctx.shadowBlur = 62 * dpr;
      ctx.shadowOffsetY = 30 * dpr;
      ctx.fillStyle = 'rgba(44, 31, 20, 0.42)';
      ctx.beginPath();
      ctx.roundRect(0, 0, plan.width, plan.height, plan.radius);
      ctx.fill();
      ctx.restore();

      ctx.save();
      ctx.strokeStyle = 'rgba(253, 250, 244, 0.74)';
      ctx.lineWidth = 1.35 * dpr;
      ctx.beginPath();
      ctx.roundRect(0, 0, plan.width, plan.height, plan.radius);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(74, 92, 64, 0.45)';
      ctx.lineWidth = 0.8 * dpr;
      ctx.beginPath();
      ctx.roundRect(plan.width * 0.018, plan.height * 0.018, plan.width * 0.964, plan.height * 0.964, plan.radius * 0.75);
      ctx.stroke();
      ctx.restore();
    };

    const drawParcelLinework = (plan) => {
      ctx.save();
      clipPlan(plan);
      ctx.strokeStyle = 'rgba(245, 239, 224, 0.16)';
      ctx.lineWidth = 0.85 * dpr;

      [
        [0.1, 0.22, 0.88, 0.18],
        [0.13, 0.46, 0.9, 0.5],
        [0.12, 0.74, 0.86, 0.68],
        [0.24, 0.09, 0.2, 0.9],
        [0.5, 0.1, 0.47, 0.92],
        [0.74, 0.08, 0.79, 0.88],
      ].forEach(([x1, y1, x2, y2]) => {
        ctx.beginPath();
        ctx.moveTo(plan.width * x1, plan.height * y1);
        ctx.lineTo(plan.width * x2, plan.height * y2);
        ctx.stroke();
      });

      ctx.strokeStyle = 'rgba(74, 92, 64, 0.4)';
      ctx.lineWidth = 1 * dpr;
      ctx.beginPath();
      ctx.moveTo(plan.width * 0.12, plan.height * 0.86);
      ctx.bezierCurveTo(
        plan.width * 0.34,
        plan.height * 0.68,
        plan.width * 0.55,
        plan.height * 0.75,
        plan.width * 0.88,
        plan.height * 0.46,
      );
      ctx.stroke();
      ctx.restore();
    };

    const drawLawnState = (plan) => {
      ctx.save();
      clipPlan(plan);

      const lawnGradient = ctx.createLinearGradient(0, 0, plan.width, plan.height);
      lawnGradient.addColorStop(0, '#73865f');
      lawnGradient.addColorStop(0.52, '#5f7139');
      lawnGradient.addColorStop(1, '#455a2d');
      ctx.fillStyle = lawnGradient;
      ctx.fillRect(0, 0, plan.width, plan.height);

      ctx.strokeStyle = 'rgba(245, 239, 224, 0.09)';
      ctx.lineWidth = 1 * dpr;

      for (let index = 1; index < 6; index += 1) {
        const x = (plan.width / 6) * index;
        ctx.beginPath();
        ctx.moveTo(x, plan.height * 0.08);
        ctx.lineTo(x, plan.height * 0.92);
        ctx.stroke();
      }

      for (let index = 1; index < 4; index += 1) {
        const y = (plan.height / 4) * index;
        ctx.beginPath();
        ctx.moveTo(plan.width * 0.06, y);
        ctx.lineTo(plan.width * 0.94, y);
        ctx.stroke();
      }

      ctx.strokeStyle = 'rgba(44, 31, 20, 0.22)';
      ctx.lineWidth = 1.4 * dpr;
      ctx.strokeRect(plan.width * 0.09, plan.height * 0.1, plan.width * 0.82, plan.height * 0.8);

      ctx.fillStyle = 'rgba(44, 31, 20, 0.13)';
      ctx.fillRect(plan.width * 0.12, plan.height * 0.14, plan.width * 0.76, plan.height * 0.045);

      ctx.strokeStyle = 'rgba(245, 239, 224, 0.14)';
      scene.specks.forEach((speck) => {
        const x = speck.x * plan.width;
        const y = speck.y * plan.height;
        const length = speck.len * plan.width;

        ctx.save();
        ctx.globalAlpha = speck.alpha;
        ctx.translate(x, y);
        ctx.rotate(speck.angle);
        ctx.beginPath();
        ctx.moveTo(-length * 0.5, 0);
        ctx.lineTo(length * 0.5, 0);
        ctx.stroke();
        ctx.restore();
      });

      ctx.restore();
    };

    const drawPathGeometry = (plan) => {
      ctx.fillStyle = 'rgba(253, 250, 244, 0.68)';
      ctx.beginPath();
      ctx.moveTo(plan.width * 0.08, plan.height * 0.78);
      ctx.bezierCurveTo(
        plan.width * 0.28,
        plan.height * 0.64,
        plan.width * 0.44,
        plan.height * 0.56,
        plan.width * 0.6,
        plan.height * 0.39,
      );
      ctx.bezierCurveTo(
        plan.width * 0.66,
        plan.height * 0.45,
        plan.width * 0.7,
        plan.height * 0.5,
        plan.width * 0.75,
        plan.height * 0.57,
      );
      ctx.bezierCurveTo(
        plan.width * 0.55,
        plan.height * 0.72,
        plan.width * 0.34,
        plan.height * 0.8,
        plan.width * 0.14,
        plan.height * 0.9,
      );
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = 'rgba(74, 60, 42, 0.34)';
      ctx.lineWidth = 1.35 * dpr;
      ctx.stroke();

      ctx.fillStyle = 'rgba(200, 96, 58, 0.36)';
      ctx.beginPath();
      ctx.roundRect(plan.width * 0.67, plan.height * 0.64, plan.width * 0.22, plan.height * 0.18, 7 * dpr);
      ctx.fill();

      ctx.strokeStyle = 'rgba(44, 31, 20, 0.2)';
      ctx.lineWidth = 1 * dpr;
      for (let index = 1; index < 4; index += 1) {
        const x = plan.width * (0.67 + index * 0.055);
        ctx.beginPath();
        ctx.moveTo(x, plan.height * 0.64);
        ctx.lineTo(x, plan.height * 0.82);
        ctx.stroke();
      }
    };

    const drawDripLinework = (plan) => {
      ctx.save();
      ctx.strokeStyle = 'rgba(44, 64, 38, 0.78)';
      ctx.lineWidth = 1.35 * dpr;
      ctx.setLineDash([6 * dpr, 5 * dpr]);

      [
        [0.2, 0.72, 0.34, 0.5, 0.52, 0.64],
        [0.33, 0.32, 0.47, 0.22, 0.7, 0.35],
        [0.53, 0.63, 0.66, 0.66, 0.82, 0.74],
      ].forEach(([x1, y1, cx, cy, x2, y2]) => {
        ctx.beginPath();
        ctx.moveTo(plan.width * x1, plan.height * y1);
        ctx.quadraticCurveTo(plan.width * cx, plan.height * cy, plan.width * x2, plan.height * y2);
        ctx.stroke();
      });

      ctx.restore();
    };

    const drawPlantCluster = (plant, plan, alpha = 1) => {
      const x = plant.x * plan.width;
      const y = plant.y * plan.height;
      const size = plant.size * Math.min(plan.width, plan.height);

      ctx.save();
      ctx.globalAlpha *= alpha;
      ctx.translate(x, y);

      if (plant.type === 'agave') {
        for (let index = 0; index < 10; index += 1) {
          ctx.save();
          ctx.rotate((Math.PI * 2 * index) / 10);
          ctx.fillStyle = index % 2 ? '#9aae86' : '#4f6b42';
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.quadraticCurveTo(size * 0.18, -size * 0.34, 0, -size);
          ctx.quadraticCurveTo(-size * 0.18, -size * 0.34, 0, 0);
          ctx.fill();
          ctx.restore();
        }

        ctx.fillStyle = '#efe4c8';
        ctx.beginPath();
        ctx.arc(0, 0, size * 0.12, 0, Math.PI * 2);
        ctx.fill();
      } else if (plant.type === 'grass') {
        ctx.strokeStyle = '#435d32';
        ctx.lineWidth = 2 * dpr;

        for (let index = -5; index <= 5; index += 1) {
          ctx.beginPath();
          ctx.moveTo(0, size * 0.45);
          ctx.quadraticCurveTo(size * index * 0.08, -size * 0.18, size * index * 0.18, -size * 0.85);
          ctx.stroke();
        }
      } else if (plant.type === 'shrub') {
        ctx.fillStyle = 'rgba(44, 31, 20, 0.16)';
        ctx.beginPath();
        ctx.ellipse(size * 0.08, size * 0.12, size * 0.62, size * 0.36, -0.2, 0, Math.PI * 2);
        ctx.fill();

        ['#526a42', '#789063', '#465b39'].forEach((color, index) => {
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(
            (index - 1) * size * 0.25,
            index === 1 ? -size * 0.08 : size * 0.05,
            size * (0.34 - index * 0.035),
            0,
            Math.PI * 2,
          );
          ctx.fill();
        });
      } else {
        for (let index = 0; index < 7; index += 1) {
          const angle = (Math.PI * 2 * index) / 7;
          ctx.fillStyle = index % 2 ? '#7a9868' : '#608050';
          ctx.beginPath();
          ctx.ellipse(
            Math.cos(angle) * size * 0.22,
            Math.sin(angle) * size * 0.22,
            size * 0.32,
            size * 0.18,
            angle,
            0,
            Math.PI * 2,
          );
          ctx.fill();
        }

        ctx.fillStyle = palette.sand;
        ctx.beginPath();
        ctx.arc(0, 0, size * 0.14, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.restore();
    };

    const drawXeriscapeState = (plan, scanProgress, alpha) => {
      ctx.save();
      clipPlan(plan);
      ctx.beginPath();
      ctx.rect(plan.width * (1 - scanProgress), 0, plan.width * scanProgress, plan.height);
      ctx.clip();
      ctx.globalAlpha = alpha;

      const dgGradient = ctx.createLinearGradient(0, 0, plan.width, plan.height);
      dgGradient.addColorStop(0, '#f4e5c4');
      dgGradient.addColorStop(0.46, '#d8bd88');
      dgGradient.addColorStop(1, '#a99067');
      ctx.fillStyle = dgGradient;
      ctx.fillRect(0, 0, plan.width, plan.height);

      ctx.fillStyle = 'rgba(125, 113, 94, 0.56)';
      ctx.beginPath();
      ctx.moveTo(plan.width * 0.04, plan.height * 0.82);
      ctx.bezierCurveTo(
        plan.width * 0.24,
        plan.height * 0.56,
        plan.width * 0.42,
        plan.height * 0.72,
        plan.width * 0.58,
        plan.height * 0.44,
      );
      ctx.bezierCurveTo(
        plan.width * 0.68,
        plan.height * 0.27,
        plan.width * 0.74,
        plan.height * 0.2,
        plan.width * 0.92,
        plan.height * 0.14,
      );
      ctx.lineTo(plan.width * 0.95, plan.height * 0.27);
      ctx.bezierCurveTo(
        plan.width * 0.76,
        plan.height * 0.34,
        plan.width * 0.73,
        plan.height * 0.44,
        plan.width * 0.61,
        plan.height * 0.58,
      );
      ctx.bezierCurveTo(
        plan.width * 0.45,
        plan.height * 0.77,
        plan.width * 0.27,
        plan.height * 0.72,
        plan.width * 0.09,
        plan.height * 0.92,
      );
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = 'rgba(253, 250, 244, 0.42)';
      ctx.lineWidth = 1 * dpr;
      ctx.stroke();

      drawPathGeometry(plan);

      scene.gravel.forEach((dot) => {
        ctx.fillStyle =
          dot.tone > 0.62
            ? 'rgba(44, 31, 20, 0.22)'
            : dot.tone > 0.34
              ? 'rgba(116, 102, 80, 0.24)'
              : 'rgba(253, 250, 244, 0.34)';
        ctx.beginPath();
        ctx.arc(dot.x * plan.width, dot.y * plan.height, dot.r * plan.width, 0, Math.PI * 2);
        ctx.fill();
      });

      [
        [0.17, 0.33, 0.058, 0.03],
        [0.43, 0.78, 0.07, 0.034],
        [0.78, 0.47, 0.056, 0.028],
        [0.59, 0.25, 0.046, 0.024],
        [0.88, 0.62, 0.044, 0.023],
        [0.31, 0.55, 0.038, 0.02],
      ].forEach(([x, y, rx, ry], index) => {
        ctx.fillStyle = index % 2 ? 'rgba(74, 60, 42, 0.64)' : 'rgba(91, 78, 58, 0.66)';
        ctx.beginPath();
        ctx.ellipse(x * plan.width, y * plan.height, rx * plan.width, ry * plan.height, -0.18, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(253, 250, 244, 0.2)';
        ctx.beginPath();
        ctx.ellipse((x - rx * 0.25) * plan.width, (y - ry * 0.2) * plan.height, rx * plan.width * 0.36, ry * plan.height * 0.28, -0.18, 0, Math.PI * 2);
        ctx.fill();
      });

      drawDripLinework(plan);
      scene.plants.forEach((plant) => drawPlantCluster(plant, plan, alpha));

      ctx.restore();
    };

    const drawScanBand = (plan, scanProgress, alpha) => {
      if (alpha <= 0.01) {
        return;
      }

      const scanX = plan.width * (1 - scanProgress) + pointerShift.x * dpr;
      const bandWidth = plan.width * (scene.mobile ? 0.18 : 0.16);

      ctx.save();
      clipPlan(plan);
      ctx.globalAlpha = alpha;

      const gradient = ctx.createLinearGradient(scanX - bandWidth, 0, scanX + bandWidth, 0);
      gradient.addColorStop(0, 'rgba(200, 96, 58, 0)');
      gradient.addColorStop(0.28, 'rgba(200, 96, 58, 0.12)');
      gradient.addColorStop(0.47, 'rgba(253, 250, 244, 0.48)');
      gradient.addColorStop(0.55, 'rgba(245, 239, 224, 0.34)');
      gradient.addColorStop(0.74, 'rgba(200, 96, 58, 0.16)');
      gradient.addColorStop(1, 'rgba(200, 96, 58, 0)');
      ctx.fillStyle = gradient;
      ctx.fillRect(scanX - bandWidth, 0, bandWidth * 2, plan.height);

      ctx.shadowColor = 'rgba(245, 239, 224, 0.5)';
      ctx.shadowBlur = 14 * dpr;
      ctx.strokeStyle = 'rgba(253, 250, 244, 0.82)';
      ctx.lineWidth = 1.55 * dpr;
      ctx.beginPath();
      ctx.moveTo(scanX, plan.height * 0.04);
      ctx.lineTo(scanX, plan.height * 0.96);
      ctx.stroke();

      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'rgba(200, 96, 58, 0.3)';
      ctx.lineWidth = 0.7 * dpr;

      [-8, 8].forEach((offset) => {
        ctx.beginPath();
        ctx.moveTo(scanX + offset * dpr, plan.height * 0.08);
        ctx.lineTo(scanX + offset * dpr, plan.height * 0.92);
        ctx.stroke();
      });

      ctx.strokeStyle = 'rgba(253, 250, 244, 0.22)';
      ctx.setLineDash([12 * dpr, 12 * dpr]);
      [-0.18, 0.18].forEach((offset) => {
        ctx.beginPath();
        ctx.moveTo(scanX - bandWidth * 0.56, plan.height * (0.5 + offset));
        ctx.lineTo(scanX + bandWidth * 0.56, plan.height * (0.5 + offset));
        ctx.stroke();
      });
      ctx.restore();
    };

    const drawPlanLabels = (plan, labelProgress, pulse) => {
      const visibleLabels = scene.mobile ? scene.labels.slice(0, 3) : scene.labels;

      visibleLabels.forEach((label) => {
        const alpha = clamp((labelProgress - label.delay) * 3.2, 0, 1);

        if (alpha <= 0) {
          return;
        }

        const x = plan.x + label.x * plan.width + pointerShift.x * dpr * 0.28;
        const y = plan.y + label.y * plan.height + pointerShift.y * dpr * 0.22;
        const fontSize = (scene.mobile ? 7.5 : 8.8) * dpr;
        const paddingX = 8 * dpr;
        const paddingY = 5 * dpr;
        const dotSize = 2.25 * dpr;

        ctx.save();
        ctx.globalAlpha = alpha * (0.82 + pulse * 0.08);
        ctx.font = `500 ${fontSize}px "DM Mono", monospace`;
        const textWidth = ctx.measureText(label.text).width;
        const chipWidth = textWidth + paddingX * 2 + dotSize * 2.5;
        const chipHeight = fontSize + paddingY * 2;

        ctx.fillStyle = 'rgba(44, 31, 20, 0.68)';
        ctx.strokeStyle = 'rgba(253, 250, 244, 0.22)';
        ctx.lineWidth = 1 * dpr;
        ctx.beginPath();
        ctx.roundRect(x, y, chipWidth, chipHeight, chipHeight * 0.5);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = palette.terracottaLight;
        ctx.beginPath();
        ctx.arc(x + paddingX, y + chipHeight * 0.5, dotSize, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = 'rgba(253, 250, 244, 0.86)';
        ctx.fillText(label.text, x + paddingX + dotSize * 2.8, y + paddingY + fontSize * 0.78);
        ctx.restore();
      });
    };

    const drawVignette = () => {
      const gradient = ctx.createRadialGradient(width * 0.48, height * 0.42, 0, width * 0.5, height * 0.52, Math.max(width, height) * 0.74);
      gradient.addColorStop(0, 'rgba(0, 0, 0, 0)');
      gradient.addColorStop(0.74, 'rgba(20, 28, 17, 0.1)');
      gradient.addColorStop(1, 'rgba(20, 28, 17, 0.34)');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, width, height);
    };

    const getAnimationState = (timestamp, staticFrame) => {
      if (staticFrame) {
        return {
          scanProgress: 1,
          xeriscapeAlpha: 1,
          scanAlpha: 0,
          labelProgress: 1,
          pulse: 0.72,
        };
      }

      const duration = 12000;
      const phase = ((timestamp - start) % duration) / duration;
      let scanProgress = 0;
      let xeriscapeAlpha = 1;
      let scanAlpha = 0;
      let labelProgress = 0;

      if (phase < 0.52) {
        const scanPhase = phase / 0.52;
        scanProgress = 0.2 + easeOut(scanPhase) * 0.8;
        scanAlpha = (0.34 + Math.sin(scanPhase * Math.PI) * 0.66) * 0.98;
        labelProgress = clamp((scanPhase - 0.18) / 0.82, 0, 1) * 0.82;
      } else if (phase < 0.82) {
        scanProgress = 1;
        scanAlpha = 0;
        labelProgress = 0.82 + easeOut((phase - 0.52) / 0.3) * 0.18;
      } else {
        const reset = easeInOut((phase - 0.82) / 0.18);
        scanProgress = 1;
        xeriscapeAlpha = 1 - reset;
        labelProgress = 1 - reset;
      }

      return {
        scanProgress,
        xeriscapeAlpha,
        scanAlpha,
        labelProgress,
        pulse: (Math.sin(phase * Math.PI * 8) + 1) / 2,
      };
    };

    const drawFrame = (timestamp, staticFrame = false) => {
      if (!scene) {
        return;
      }

      const state = getAnimationState(timestamp, staticFrame);
      const plan = getPlan();

      drawBackground();

      withPlanTransform(plan, () => {
        drawYardPlan(plan);
        drawLawnState(plan);
        drawParcelLinework(plan);
        drawXeriscapeState(plan, state.scanProgress, state.xeriscapeAlpha);
        drawScanBand(plan, state.scanProgress, state.scanAlpha);
      });

      drawPlanLabels(plan, state.labelProgress, state.pulse);
      drawVignette();
    };

    const animate = (timestamp) => {
      if (hidden || reducedMotion) {
        frameId = 0;
        return;
      }

      drawFrame(timestamp);
      frameId = window.requestAnimationFrame(animate);
    };

    const startAnimation = () => {
      if (frameId || hidden || reducedMotion) {
        return;
      }

      start = performance.now();
      frameId = window.requestAnimationFrame(animate);
    };

    const stopAnimation = () => {
      if (frameId) {
        window.cancelAnimationFrame(frameId);
        frameId = 0;
      }
    };

    const handlePointerMove = (event) => {
      const rect = stage.getBoundingClientRect();
      const source = 'touches' in event ? event.touches[0] : event;

      if (!source) {
        return;
      }

      pointerShift = {
        x: clamp((source.clientX - rect.left) / rect.width - 0.5, -0.5, 0.5) * 10,
        y: clamp((source.clientY - rect.top) / rect.height - 0.5, -0.5, 0.5) * 8,
      };
    };

    const handleVisibility = () => {
      hidden = document.hidden;

      if (hidden) {
        stopAnimation();
        return;
      }

      startAnimation();
    };

    const handleMotionChange = () => {
      reducedMotion = motionQuery.matches;
      stopAnimation();

      if (reducedMotion) {
        drawFrame(1, true);
        return;
      }

      startAnimation();
    };

    const resizeObserver = new ResizeObserver(resizeYardCanvas);
    resizeObserver.observe(stage);
    stage.addEventListener('mousemove', handlePointerMove);
    stage.addEventListener('touchmove', handlePointerMove, { passive: true });
    document.addEventListener('visibilitychange', handleVisibility);
    motionQuery.addEventListener('change', handleMotionChange);
    resizeYardCanvas();

    if (reducedMotion) {
      drawFrame(1, true);
    } else {
      startAnimation();
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYardScan, { once: true });
  } else {
    initYardScan();
  }
</script>
