---
import { cityOptions } from '../data/cities';
import { lawnSizes, leadFormProjectTypes } from '../data/site';
import FormHandler from './FormHandler.astro';

interface Props { formId?: string; sourcePage?: string; }
const { formId = 'project-brief-form', sourcePage = Astro.url.pathname } = Astro.props;
const timings = ['As soon as practical', 'Within 1–3 months', 'Within 3–6 months', '6+ months / researching'];
const attributionFields = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'gclid', 'gbraid', 'wbraid', 'msclkid'];
---

<form id={formId} class="lead-form" action="/api/lead" method="post" data-submission-form data-start-event="project_brief_start" data-success-event="project_brief_submit_success" data-error-event="project_brief_submit_error">
  <h2 class="lead-form__title">Free SGV Yard Project Brief</h2>
  <p class="lead-form__subtitle">Required fields are marked “required.”</p>
  <input type="hidden" name="submissionType" value="homeowner_project_brief" />
  <input type="hidden" name="sourcePage" value={sourcePage} />
  {attributionFields.map((name) => <input type="hidden" name={name} value="" />)}

  <div class="form-row">
    <label class="field"><span class="field__label">Name — required</span><input class="field__control" type="text" name="name" autocomplete="name" maxlength="120" required /><span class="field__error" data-field-error="name"></span></label>
    <label class="field"><span class="field__label">Email — required</span><input class="field__control" type="email" name="email" autocomplete="email" maxlength="200" required /><span class="field__error" data-field-error="email"></span></label>
  </div>
  <div class="form-row">
    <label class="field"><span class="field__label">Phone — required</span><input class="field__control" type="tel" name="phone" autocomplete="tel" maxlength="40" required /><span class="field__error" data-field-error="phone"></span></label>
    <label class="field"><span class="field__label">ZIP code — required</span><input class="field__control" type="text" name="zipCode" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" required /><span class="field__error" data-field-error="zipCode"></span></label>
  </div>
  <div class="form-row">
    <label class="field"><span class="field__label">City — required</span><select class="field__control" name="city" autocomplete="address-level2" required><option value="">Select city</option>{cityOptions.map((city) => <option value={city}>{city}</option>)}</select><span class="field__error" data-field-error="city"></span></label>
    <label class="field"><span class="field__label">Approximate yard size — required</span><select class="field__control" name="yardSize" required><option value="">Select size</option>{lawnSizes.map((size) => <option value={size}>{size} sq ft</option>)}</select><span class="field__error" data-field-error="yardSize"></span></label>
  </div>
  <div class="form-row">
    <label class="field"><span class="field__label">Project type — required</span><select class="field__control" name="projectType" required><option value="">Select project type</option>{leadFormProjectTypes.map((item) => <option value={item}>{item}</option>)}</select><span class="field__error" data-field-error="projectType"></span></label>
    <label class="field"><span class="field__label">Project timing — required</span><select class="field__control" name="timing" required><option value="">Select timing</option>{timings.map((item) => <option value={item}>{item}</option>)}</select><span class="field__error" data-field-error="timing"></span></label>
  </div>
  <label class="field"><span class="field__label">Short project description — required</span><textarea class="field__control field__control--textarea" name="message" maxlength="3000" placeholder="Current yard, goals, desired work, access or timing details." required></textarea><span class="field__error" data-field-error="message"></span></label>

  <div class="form-disclosure" id={`${formId}-disclosure`}>
    SGVTurf is a planning and referral resource, not a landscape contractor. Independent contractors perform the work. By submitting this brief, you agree that SGVTurf may share your project information with a limited number of potentially relevant contractors. Contractor availability, licensing, estimates, project terms, workmanship, and rebate eligibility must be confirmed directly.
  </div>
  <label class="checkbox-field"><input type="checkbox" name="sharingConsent" value="yes" required aria-describedby={`${formId}-disclosure`} /><span>I consent to the limited contractor sharing described above — required.</span></label>
  <span class="field__error" data-field-error="sharingConsent"></span>

  <div class="field field--hidden" aria-hidden="true"><label>Leave this field blank<input type="text" name="faxNumber" tabindex="-1" autocomplete="off" /></label></div>
  <button class="button button--primary button--submit" type="submit" data-submit-button>Send My Free Project Brief</button>
  <p class="lead-form__status" data-form-status aria-live="polite" hidden></p>
  <p class="lead-form__note">See the <a class="text-link" href="/privacy/">Privacy Policy</a> and <a class="text-link" href="/how-it-works/">Referral Disclosure</a>. No contractor response, estimate, availability, or result is guaranteed.</p>
</form>
<FormHandler />
