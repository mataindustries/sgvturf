---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import YardOptions from '../components/YardOptions.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeaturedContractors from '../components/FeaturedContractors.astro';
import EditorialGrid from '../components/EditorialGrid.astro';
import FoundingPilotInvite from '../components/FoundingPilotInvite.astro';
import Footer from '../components/Footer.astro';
import { createOrganizationSchema, createServiceSchema, createWebsiteSchema } from '../lib/seo';
import { defaultDescription, defaultTitle } from '../data/site';

const title = defaultTitle;
const description = defaultDescription;

const structuredData = [
  createOrganizationSchema(Astro.site),
  createWebsiteSchema(Astro.site),
  createServiceSchema(
    {
      name: 'SGV drought-smart landscape planning guidance',
      description,
      serviceType:
        'Regional planning guidance, project briefs, and official-source rebate research',
      path: '/',
      areaServed: 'San Gabriel Valley',
      areaType: 'AdministrativeArea',
    },
    Astro.site,
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl="/"
  ogTitle="SGV Turf | City Guides, Rebates, and Water-Wise Project Planning"
  ogDescription="Browse SGV city guides, honest referral guidance, rebate planning, and editorial landscape resources for lower-water yard projects."
  structuredData={structuredData}
>
  <Nav />
  <main id="main-content">
    <Hero />
    <YardOptions />
    <HowItWorks />
    <FeaturedContractors />
    <EditorialGrid />
    <FoundingPilotInvite />
  </main>
  <Footer />
</BaseLayout>
