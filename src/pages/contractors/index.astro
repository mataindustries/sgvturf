---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CollectionCta from '../../components/CollectionCta.astro';
import { createBreadcrumbSchema } from '../../lib/seo';

const structuredData = createBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Verified Contractor Directory', path: '/contractors/' },
], Astro.site);
---

<BaseLayout title="Verified SGV Contractor Directory | SGV Turf" description="The SGV Turf verified contractor roster is opening now. No illustrative businesses or placeholder listings appear in this directory." canonicalUrl="/contractors/" ogTitle="Verified SGV Contractor Directory | SGV Turf" ogDescription="The founding verified-contractor roster is opening now." structuredData={structuredData}>
  <Nav />
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contractors' }]} />
  <main id="main-content">
    <PageHero eyebrow="Verified Contractor Directory" description="Only verified real businesses supplied to SGV Turf will appear here. The founding roster is opening now, and no placeholder businesses are being used." meta={['0 published listings', 'Verified businesses only', 'Founding roster opening']} actions={[{ href: '/sgv-yard-project/', label: 'Start a Project Brief' }, { href: '/contractors/join/', label: 'For Contractors', variant: 'ghost' }]}>
      <span slot="title">An honest directory,<br /><em>ready for real partners.</em></span>
    </PageHero>
    <section class="surface-section surface-section--white">
      <div class="section-shell">
        <div class="empty-state">
          <p class="section-eyebrow">Current Roster</p>
          <h2 class="empty-state__title">No verified contractor profiles are published yet.</h2>
          <p class="empty-state__copy">SGV Turf is opening its first 3 founding partner spots. Homeowners can still submit a project brief; SGV Turf will only share it, with consent, when a potentially relevant independent contractor is available.</p>
          <div class="collection-cta__actions"><a class="button button--primary" href="/sgv-yard-project/">Start a Free Project Brief</a><a class="button button--ghost" href="/project-style-guides/">View Illustrative Style Guides</a></div>
        </div>
      </div>
    </section>
    <CollectionCta eyebrow="Founding Partner Spots" title="Are you an established SGV landscape contractor?" text="Review the temporary 30-day founding pilot and submit a short real-business intake." primaryHref="/contractors/join/" primaryLabel="Apply for a Founding Spot" />
  </main>
  <Footer />
</BaseLayout>
