---
import BaseLayout from '../layouts/BaseLayout.astro'; import Nav from '../components/Nav.astro'; import Footer from '../components/Footer.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Referral Disclosure & How SGVTurf Works" description="Plain-language disclosure of SGVTurf's planning and contractor-referral role." canonicalUrl="/how-it-works/">
  <Nav /><main id="main-content"><PageHero eyebrow="Referral Disclosure" description="A plain-language explanation of SGVTurf's role before you submit a project brief or contact a contractor." meta={['SGVTurf is not an installer', 'Independent businesses', 'No outcome guarantee']}><span slot="title">How SGVTurf<br /><em>works.</em></span></PageHero><section class="surface-section surface-section--cream"><div class="section-shell detail-grid"><div class="detail-main"><article class="detail-panel"><p class="detail-panel__eyebrow">1 · Plan</p><h2 class="detail-panel__title">Homeowners submit a focused project brief.</h2><p class="detail-panel__copy">SGVTurf uses it to respond, organize the request, measure the funnel, and understand possible project fit.</p></article><article class="detail-panel"><p class="detail-panel__eyebrow">2 · Check</p><h2 class="detail-panel__title">SGVTurf may check independent-contractor fit.</h2><p class="detail-panel__copy">Only with the disclosed consent in the form, SGVTurf may share the request with a limited number of potentially relevant contractors. Availability and response are not guaranteed.</p></article><article class="detail-panel"><p class="detail-panel__eyebrow">3 · Confirm</p><h2 class="detail-panel__title">Homeowners and contractors deal directly.</h2><p class="detail-panel__copy">Contractors are independent businesses. Confirm licensing, availability, estimates, project terms, pricing, suitability, workmanship, insurance, and rebate eligibility directly before proceeding.</p></article></div><aside class="detail-sidebar"><div class="meta-block"><p class="meta-block__title">Referral Limits</p><p class="meta-block__text">A listing, introduction, or referral is not an endorsement or guarantee of any contractor or outcome.</p></div><div class="meta-block"><p class="meta-block__title">Commercial Disclosure</p><p class="meta-block__text">SGVTurf may offer contractors paid placement after a pilot. Placement does not change the homeowner’s responsibility to verify contractor details.</p></div></aside></div></section></main><Footer />
</BaseLayout>
