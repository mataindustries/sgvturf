---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Nav from '../../components/Nav.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import Footer from '../../components/Footer.astro'; import PageHero from '../../components/PageHero.astro'; import CollectionCta from '../../components/CollectionCta.astro'; import RebateCard from '../../components/RebateCard.astro'; import FAQItem from '../../components/FAQItem.astro'; import { rebateEntries, rebateFaqs } from '../../data/rebates'; import { createBreadcrumbSchema } from '../../lib/seo';
const structuredData = createBreadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Rebates', path: '/rebates/' }], Astro.site);
---
<BaseLayout title="Official-Source SGV Rebate Planning | SGVTurf" description="Check official-source turf-replacement information, pre-approval warnings, and the distinction between artificial turf and rebate-eligible lawn-to-garden conversion." canonicalUrl="/rebates/" ogTitle="SGV Turf Replacement Rebate Planning | Official Sources" ogDescription="Confirm your water provider and obtain required approval before removing turf or starting work." structuredData={structuredData}>
  <Nav /><Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Rebates' }]} /><main id="main-content">
    <PageHero eyebrow="Official-Source Rebate Planning" description="Confirm the property's water provider and obtain required approval before removing turf or starting work. Program rules, eligibility, and funding can change." meta={['2 verified official sources', 'Pre-approval may be required', 'No speculative ranges']} actions={[{ href: '/sgv-yard-project/', label: 'Start My Project Brief' }]}><span slot="title">Rebate research<br /><em>before demolition.</em></span></PageHero>
    <section class="surface-section surface-section--white"><div class="section-shell"><div class="warning-panel"><p class="section-eyebrow">Important distinction</p><h2 class="detail-panel__title">Artificial turf installation is not a rebate-eligible lawn-to-garden conversion.</h2><p class="detail-panel__copy">SoCal Water$mart does not approve synthetic/artificial turf as a conversion option. If you are evaluating artificial turf, treat it as a separate installation decision and do not assume a turf-replacement rebate applies.</p></div></div></section>
    <section class="surface-section surface-section--cream"><div class="section-shell"><div class="section-header"><div><p class="section-eyebrow">Verified Programs</p><h2 class="section-title">Start with the <em>official source.</em></h2></div></div><p class="collection-lede">If your utility is not listed, the correct published amount here is: <strong>Verify with your utility.</strong> SGVTurf does not apply a neighboring program’s number to your property.</p><div class="rebate-grid">{rebateEntries.map((entry) => <RebateCard entry={entry} />)}</div></div></section>
    <section class="surface-section surface-section--white"><div class="section-shell"><div class="section-header"><div><p class="section-eyebrow">FAQ</p><h2 class="section-title">Plan around <em>current requirements.</em></h2></div></div><div class="faq-list">{rebateFaqs.map((item, index) => <FAQItem question={item.question} answer={item.answer} open={index === 0} />)}</div></div></section>
    <CollectionCta eyebrow="Next Step" title="Record the utility and approval status in your brief." text="A verified program source is useful context, but the utility makes the eligibility decision." primaryHref="/sgv-yard-project/" primaryLabel="Start My Project Brief" secondaryHref="/resources/" secondaryLabel="Read Planning Resources" />
  </main><Footer />
</BaseLayout>
